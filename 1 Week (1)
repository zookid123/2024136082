클로드로 제작한 사이트 코드

<!DOCTYPE html>
<html lang="ko">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>홈 대시보드</title>
<style>
  * { margin: 0; padding: 0; box-sizing: border-box; }

  body {
    font-family: 'Segoe UI', sans-serif;
    min-height: 100vh;
    background: linear-gradient(135deg, #e8f4fd 0%, #f0f8ff 50%, #e8f0fe 100%);
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    padding: 24px;
  }

  .container {
    width: 100%;
    max-width: 680px;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 36px;
  }

  /* 시계 */
  .clock-card {
    background: rgba(255,255,255,0.75);
    backdrop-filter: blur(16px);
    border-radius: 28px;
    padding: 36px 52px;
    text-align: center;
    box-shadow: 0 4px 32px rgba(99,153,255,0.10), 0 1px 4px rgba(0,0,0,0.06);
    border: 1px solid rgba(255,255,255,0.9);
    width: 100%;
  }

  #time {
    font-size: 72px;
    font-weight: 400;
    letter-spacing: -2px;
    color: #1a1a2e;
    line-height: 1;
  }

  #time span.colon {
    opacity: 1;
    animation: blink 1s step-end infinite;
  }

  @keyframes blink {
    50% { opacity: 0.2; }
  }

  #date {
    margin-top: 10px;
    font-size: 15px;
    color: #4e6070;
    font-weight: 500;
    letter-spacing: 0.3px;
  }

  #greeting {
    margin-top: 6px;
    font-size: 13px;
    color: #6a7e92;
    font-weight: 500;
  }

  /* 검색바 */
  .search-section {
    width: 100%;
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  .search-wrap {
    position: relative;
    width: 100%;
  }

  .search-wrap svg {
    position: absolute;
    left: 18px;
    top: 50%;
    transform: translateY(-50%);
    color: #a0b0c8;
    pointer-events: none;
  }

  #search-input {
    width: 100%;
    padding: 16px 52px 16px 50px;
    border-radius: 20px;
    border: 1.5px solid rgba(180,210,255,0.5);
    background: rgba(255,255,255,0.85);
    backdrop-filter: blur(10px);
    font-size: 16px;
    color: #1a1a2e;
    outline: none;
    transition: all 0.2s;
    box-shadow: 0 2px 16px rgba(99,153,255,0.08);
  }

  #search-input::placeholder { color: #b0c0d8; }

  #search-input:focus {
    border-color: #6699ff;
    background: rgba(255,255,255,0.97);
    box-shadow: 0 4px 24px rgba(99,153,255,0.18);
  }

  #search-btn {
    position: absolute;
    right: 10px;
    top: 50%;
    transform: translateY(-50%);
    background: linear-gradient(135deg, #6699ff, #5577ee);
    border: none;
    border-radius: 12px;
    width: 38px;
    height: 38px;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    transition: opacity 0.2s, transform 0.15s;
  }

  #search-btn:hover { opacity: 0.88; transform: translateY(-50%) scale(1.05); }

  /* 검색 엔진 탭 */
  .engine-tabs {
    display: flex;
    gap: 8px;
    justify-content: center;
  }

  .engine-tab {
    padding: 6px 16px;
    border-radius: 20px;
    font-size: 13px;
    cursor: pointer;
    border: 1.5px solid transparent;
    background: rgba(255,255,255,0.6);
    color: #7a8aa0;
    transition: all 0.18s;
    font-weight: 500;
  }

  .engine-tab.active {
    background: rgba(255,255,255,0.95);
    border-color: #6699ff;
    color: #4466dd;
    box-shadow: 0 2px 10px rgba(99,153,255,0.12);
  }

  .engine-tab:hover:not(.active) { background: rgba(255,255,255,0.85); color: #4a5a70; }

  /* 빠른 링크 */
  .quick-links {
    width: 100%;
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 12px;
  }

  .link-card {
    background: rgba(255,255,255,0.72);
    backdrop-filter: blur(10px);
    border-radius: 18px;
    padding: 18px 10px;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 8px;
    cursor: pointer;
    border: 1px solid rgba(255,255,255,0.85);
    box-shadow: 0 2px 12px rgba(99,153,255,0.07);
    transition: all 0.2s;
    text-decoration: none;
  }

  .link-card:hover {
    background: rgba(255,255,255,0.95);
    transform: translateY(-2px);
    box-shadow: 0 6px 24px rgba(99,153,255,0.14);
  }

  .link-icon {
    width: 40px;
    height: 40px;
    border-radius: 12px;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 20px;
  }

  .link-label {
    font-size: 12px;
    color: #4e6070;
    font-weight: 600;
    text-align: center;
  }

  .card-title {
    font-size: 11px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.8px;
    color: #7a90a4;
    margin-bottom: 10px;
  }

  .weather-temp {
    font-size: 28px;
    font-weight: 400;
    color: #1a1a2e;
  }

  .weather-desc {
    font-size: 13px;
    color: #4e6070;
    margin-top: 2px;
  }

  /* 날씨 + 메모 row */
  .bottom-row {
    width: 100%;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 12px;
  }

  .info-card {
    background: rgba(255,255,255,0.72);
    backdrop-filter: blur(10px);
    border-radius: 20px;
    padding: 20px 22px;
    border: 1px solid rgba(255,255,255,0.85);
    box-shadow: 0 2px 12px rgba(99,153,255,0.07);
  }

  .info-card .card-title {
    font-size: 11px;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.8px;
    color: #b0c0d8;
    margin-bottom: 10px;
  }

  .weather-main {
    display: flex;
    align-items: center;
    gap: 10px;
  }

  .weather-icon { font-size: 32px; }

  .weather-temp {
    font-size: 28px;
    font-weight: 300;
    color: #1a1a2e;
  }

  .weather-desc {
    font-size: 13px;
    color: #7a8aa0;
    margin-top: 2px;
  }

  #memo-input {
    width: 100%;
    background: transparent;
    border: none;
    outline: none;
    font-size: 13px;
    color: #4a5a70;
    resize: none;
    height: 56px;
    font-family: inherit;
    line-height: 1.6;
  }

  #memo-input::placeholder { color: #c0d0e0; }
</style>
</head>
<body>
<div class="container">

  <!-- 시계 -->
  <div class="clock-card">
    <div id="time"><span id="h">00</span><span class="colon">:</span><span id="m">00</span><span class="colon">:</span><span id="s">00</span></div>
    <div id="date"></div>
    <div id="greeting"></div>
  </div>

  <!-- 검색바 -->
  <div class="search-section">
    <div class="search-wrap">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/>
      </svg>
      <input id="search-input" type="text" placeholder="검색어를 입력하세요..." autocomplete="off">
      <button id="search-btn" onclick="doSearch()">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
          <line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/>
        </svg>
      </button>
    </div>
    <div class="engine-tabs">
      <div class="engine-tab active" onclick="setEngine('google', this)">Google</div>
      <div class="engine-tab" onclick="setEngine('naver', this)">Naver</div>
      <div class="engine-tab" onclick="setEngine('bing', this)">Bing</div>
      <div class="engine-tab" onclick="setEngine('youtube', this)">YouTube</div>
    </div>
  </div>

  <!-- 빠른 링크 -->
  <div class="quick-links">
    <a class="link-card" href="https://gmail.com" target="_blank">
      <div class="link-icon" style="background:#fff0f0">
        <!-- Gmail -->
        <svg width="24" height="24" viewBox="0 0 48 48" xmlns="http://www.w3.org/2000/svg">
          <path fill="#EA4335" d="M6 40h6V22.5L4 17v20c0 1.657 1.343 3 3 3z"/>
          <path fill="#34A853" d="M36 40h6c1.657 0 3-1.343 3-3V17l-9 5.5z"/>
          <path fill="#FBBC05" d="M36 10v12.5l9-5.5V11c0-3.713-4.234-5.828-7.2-3.6z"/>
          <path fill="#EA4335" d="M12 22.5V10l12 9 12-9v12.5L24 31.5z"/>
          <path fill="#C5221F" d="M4 11v6l8 5.5V10L9.2 7.4C6.234 5.172 2 7.287 2 11z"/>
        </svg>
      </div>
      <span class="link-label">Gmail</span>
    </a>
    <a class="link-card" href="https://youtube.com" target="_blank">
      <div class="link-icon" style="background:#fff4f4">
        <!-- YouTube -->
        <svg width="26" height="20" viewBox="0 0 48 34" xmlns="http://www.w3.org/2000/svg">
          <path fill="#FF0000" d="M47.52 5.306S47.05 2.168 45.67.77C43.9-1.07 41.9-1.08 41 -.972 34.28-.5 24.003-.5 24.003-.5S13.72-.5 7-.972C6.1-1.08 4.1-1.07 2.33.77.95 2.168.48 5.306.48 5.306S0 8.996 0 12.69v3.45c0 3.69.48 7.384.48 7.384s.47 3.138 1.85 4.536c1.77 1.84 4.09 1.782 5.12 1.976C10.88 29.686 24 29.8 24 29.8s10.29-.016 17.01-.49c.9-.108 2.9-.098 4.67-1.938 1.38-1.398 1.85-4.536 1.85-4.536S48 19.83 48 16.14v-3.45c0-3.694-.48-7.384-.48-7.384z"/>
          <polygon fill="#FFFFFF" points="19,8.5 19,21.5 32,15"/>
        </svg>
      </div>
      <span class="link-label">YouTube</span>
    </a>
    <a class="link-card" href="https://github.com" target="_blank">
      <div class="link-icon" style="background:#f4f4ff">
        <!-- GitHub -->
        <svg width="26" height="26" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
          <path fill="#1b1f23" d="M12 .297c-6.63 0-12 5.373-12 12 0 5.303 3.438 9.8 8.205 11.385.6.113.82-.258.82-.577 0-.285-.01-1.04-.015-2.04-3.338.724-4.042-1.61-4.042-1.61-.546-1.385-1.335-1.755-1.335-1.755-1.087-.744.084-.729.084-.729 1.205.084 1.838 1.236 1.838 1.236 1.07 1.835 2.809 1.305 3.495.998.108-.776.417-1.305.76-1.605-2.665-.3-5.466-1.332-5.466-5.93 0-1.31.465-2.38 1.235-3.22-.135-.303-.54-1.523.105-3.176 0 0 1.005-.322 3.3 1.23.96-.267 1.98-.399 3-.405 1.02.006 2.04.138 3 .405 2.28-1.552 3.285-1.23 3.285-1.23.645 1.653.24 2.873.12 3.176.765.84 1.23 1.91 1.23 3.22 0 4.61-2.805 5.625-5.475 5.92.42.36.81 1.096.81 2.22 0 1.606-.015 2.896-.015 3.286 0 .315.21.69.825.57C20.565 22.092 24 17.592 24 12.297c0-6.627-5.373-12-12-12"/>
        </svg>
      </div>
      <span class="link-label">GitHub</span>
    </a>
    <a class="link-card" href="https://notion.so" target="_blank">
      <div class="link-icon" style="background:#f8f8f8">
        <!-- Notion -->
        <svg width="24" height="24" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
          <path fill="#000000" d="M4.459 4.208c.746.606 1.026.56 2.428.466l13.215-.793c.28 0 .047-.28-.046-.326L17.86 1.968c-.42-.326-.981-.7-2.055-.607L3.01 2.295c-.466.046-.56.28-.374.466zm.793 3.08v13.904c0 .747.373 1.027 1.214.98l14.523-.84c.841-.046.935-.56.935-1.167V6.354c0-.606-.233-.933-.748-.887l-15.177.887c-.56.047-.747.327-.747.933zm14.337.745c.093.42 0 .84-.42.888l-.7.14v10.264c-.608.327-1.168.514-1.635.514-.748 0-.935-.234-1.495-.933l-4.577-7.186v6.952L12.21 19s0 .84-1.168.84l-3.222.186c-.093-.186 0-.653.327-.746l.84-.233V9.854L7.822 9.76c-.094-.42.14-1.026.793-1.073l3.456-.233 4.764 7.279v-6.44l-1.215-.139c-.093-.514.28-.887.747-.933zM1.936 1.035l13.31-.98c1.634-.14 2.055-.047 3.082.7l4.249 2.986c.7.513.934.653.934 1.213v16.378c0 1.026-.373 1.634-1.68 1.726l-15.458.934c-.98.047-1.448-.093-1.962-.747l-3.129-4.06c-.56-.747-.793-1.306-.793-1.96V2.667c0-.839.374-1.54 1.447-1.632z"/>
        </svg>
      </div>
      <span class="link-label">Notion</span>
    </a>
  </div>

  <!-- 날씨 + 메모 -->
  <div class="bottom-row">
    <div class="info-card">
      <div class="card-title">오늘의 날씨</div>
      <div class="weather-main">
        <div class="weather-icon">⛅</div>
        <div>
          <div class="weather-temp">12°</div>
          <div class="weather-desc">성남 · 구름 조금</div>
        </div>
      </div>
    </div>
    <div class="info-card" style="grid-column: span 1;">
      <div class="card-title" style="display:flex;justify-content:space-between;align-items:center;">
        <span>오늘의 뉴스</span>
        <button class="news-refresh-btn" id="news-btn" onclick="fetchNews()">새로고침</button>
      </div>
      <div class="news-body" id="news-body">
        <span class="news-loading">📰 뉴스 불러오는 중...</span>
      </div>
    </div>
  </div>

</div>

<script>
  const engines = {
    google: 'https://www.google.com/search?q=',
    naver: 'https://search.naver.com/search.naver?query=',
    bing: 'https://www.bing.com/search?q=',
    youtube: 'https://www.youtube.com/results?search_query='
  };
  let currentEngine = 'google';

  function setEngine(e, el) {
    currentEngine = e;
    document.querySelectorAll('.engine-tab').forEach(t => t.classList.remove('active'));
    el.classList.add('active');
  }

  function doSearch() {
    const q = document.getElementById('search-input').value.trim();
    if (q) window.open(engines[currentEngine] + encodeURIComponent(q), '_blank');
  }

  document.getElementById('search-input').addEventListener('keydown', e => {
    if (e.key === 'Enter') doSearch();
  });

  // 시계
  function updateClock() {
    const now = new Date();
    const pad = n => String(n).padStart(2, '0');
    document.getElementById('h').textContent = pad(now.getHours());
    document.getElementById('m').textContent = pad(now.getMinutes());
    document.getElementById('s').textContent = pad(now.getSeconds());

    const days = ['일요일','월요일','화요일','수요일','목요일','금요일','토요일'];
    document.getElementById('date').textContent =
      `${now.getFullYear()}년 ${now.getMonth()+1}월 ${now.getDate()}일 ${days[now.getDay()]}`;

    const h = now.getHours();
    const g = h < 6 ? '🌙 좋은 밤이에요' : h < 12 ? '🌤 좋은 아침이에요' : h < 18 ? '☀️ 좋은 오후에요' : '🌆 좋은 저녁이에요';
    document.getElementById('greeting').textContent = g;
  }

  // 뉴스
  async function fetchNews() {
    const body = document.getElementById('news-body');
    const btn = document.getElementById('news-btn');
    body.innerHTML = '<span class="news-loading">📰 뉴스 불러오는 중...</span>';
    btn.disabled = true;

    try {
      const res = await fetch('https://api.anthropic.com/v1/messages', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          model: 'claude-sonnet-4-20250514',
          max_tokens: 1000,
          tools: [{ type: 'web_search_20250305', name: 'web_search' }],
          messages: [{
            role: 'user',
            content: '오늘 한국 주요 뉴스 5개를 검색해서 JSON 배열로만 답해줘. 다른 말은 하지 말고 아래 형식만: [{"title":"제목","source":"언론사","url":"링크"}]'
          }]
        })
      });
      const data = await res.json();
      const text = data.content.filter(b => b.type === 'text').map(b => b.text).join('');
      const clean = text.replace(/```json|```/g, '').trim();
      const news = JSON.parse(clean);

      body.innerHTML = news.map(n => `
        <a class="news-item" href="${n.url}" target="_blank">
          <div class="news-dot"></div>
          <div>
            <div class="news-title">${n.title}</div>
            <div class="news-source">${n.source}</div>
          </div>
        </a>`).join('');
    } catch(e) {
      body.innerHTML = '<span class="news-loading">뉴스를 불러올 수 없어요 😥</span>';
    }
    btn.disabled = false;
  }
  fetchNews();



  updateClock();
  setInterval(updateClock, 1000);
</script>
</body>
</html>
